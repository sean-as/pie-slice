# Copy to .env next to compose.yaml on the VM. Never commit the real file.

# Image repository (no tag). The deploy job passes IMAGE_TAG=<sha> per run.
IMAGE_REPO=us-central1-docker.pkg.dev/PROJECT_ID/pie-slice/pie-slice
# IMAGE_TAG=latest

# Optional overrides (defaults shown).
# DOCS_ENABLED=false
# TOKEN_TTL_DAYS=90

# Required by compose.yaml. The deploy job fills it from Secret Manager
# (secret: signup-code); set it by hand only for a manual `docker compose up`.
# SIGNUP_CODE=
