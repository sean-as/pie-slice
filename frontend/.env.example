# Copy to .env.local to override. Defaults to http://localhost:8000/api
# (the FastAPI backend's default uvicorn port) if unset.
VITE_API_URL=http://localhost:8000/api
# Open the app and the API on the same hostname (both localhost, or both
# 127.0.0.1): the session cookie is SameSite=Lax and is not sent across sites.
