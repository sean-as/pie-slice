# Copy to .env to override (loaded automatically via python-dotenv).
# Any SQLAlchemy-supported connection string works — the app doesn't use
# any SQLite- or Postgres-specific SQL, so switching backends is just this
# line plus installing that backend's driver (e.g. `uv add psycopg2-binary`).

# Default if unset — a local SQLite file:
DATABASE_URL=sqlite:///./pieslice.db

# Postgres example (after `uv add psycopg2-binary`):
# DATABASE_URL=postgresql://user:password@localhost:5432/pieslice

# The session cookie is Secure by default. For plain-http local dev (Safari
# rejects Secure cookies on http://localhost) turn it off here only:
COOKIE_SECURE=false

# Signup is open locally. Set a code to require it (the signup form has an
# "Invite code" field):
# SIGNUP_CODE=
